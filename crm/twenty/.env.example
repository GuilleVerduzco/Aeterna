# Twenty CRM — variables de entorno. Copia a .env (o corre ./setup.sh, que lo genera con secretos).

# Versión de la imagen twentycrm/twenty. Fija una versión concreta en producción (no "latest")
# y súbela a mano siguiendo INSTALL.md → "Actualizar".
TAG=v2.43.0

# Puerto del host donde queda Twenty (solo en 127.0.0.1; Caddy lo publica con HTTPS).
TWENTY_PORT=3001

# URL pública con la que tus usuarios abren el CRM. Debe coincidir EXACTAMENTE con la que usan
# en el navegador (esquema + dominio + puerto), o fallarán el login y los enlaces.
#   Local:      http://localhost:3001
#   Producción: https://crm.tu-dominio.com
SERVER_URL=http://localhost:3001

# Base de datos Postgres (contenedor "db"). Usa una contraseña fuerte SIN caracteres especiales
# (va dentro de una URL de conexión).
PG_DATABASE_USER=postgres
PG_DATABASE_PASSWORD=replace_me_with_a_strong_password_without_special_characters
PG_DATABASE_HOST=db
PG_DATABASE_PORT=5432
PG_DATABASE_NAME=default
REDIS_URL=redis://redis:6379

# Llave de cifrado de tokens y credenciales. Genérala con: openssl rand -base64 32
# ¡Respáldala! Si la pierdes, las cuentas conectadas (Gmail, Calendar, etc.) dejan de funcionar.
ENCRYPTION_KEY=replace_me_with_a_random_string
# FALLBACK_ENCRYPTION_KEY=   # solo al rotar: pon aquí la ENCRYPTION_KEY anterior

# Archivos adjuntos: "local" (volumen de Docker) o "s3" (AWS S3, Cloudflare R2, DigitalOcean Spaces…)
STORAGE_TYPE=local
# STORAGE_S3_REGION=us-east-1
# STORAGE_S3_NAME=my-bucket
# STORAGE_S3_ENDPOINT=
# STORAGE_S3_ACCESS_KEY_ID=
# STORAGE_S3_SECRET_ACCESS_KEY=

# Opcionales (descoméntalos también en docker-compose.yml para que lleguen al contenedor):
# Correo saliente (invitaciones, restablecer contraseña) — ver INSTALL.md
# EMAIL_DRIVER=smtp
# EMAIL_FROM_ADDRESS=crm@tu-dominio.com
# EMAIL_FROM_NAME="Æterna CRM"
# EMAIL_SMTP_HOST=smtp.gmail.com
# EMAIL_SMTP_PORT=465
# EMAIL_SMTP_USER=
# EMAIL_SMTP_PASSWORD=
#
# Login con Google + sincronizar Gmail/Calendar — ver INSTALL.md
# AUTH_GOOGLE_ENABLED=true
# MESSAGING_PROVIDER_GMAIL_ENABLED=true
# CALENDAR_PROVIDER_GOOGLE_ENABLED=true
# AUTH_GOOGLE_CLIENT_ID=
# AUTH_GOOGLE_CLIENT_SECRET=
# AUTH_GOOGLE_CALLBACK_URL=https://crm.tu-dominio.com/auth/google/redirect
# AUTH_GOOGLE_APIS_CALLBACK_URL=https://crm.tu-dominio.com/auth/google-apis/get-access-token
