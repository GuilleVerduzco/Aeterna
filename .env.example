# 🔐 CONFIGURACIÓN - COPIA COMO .env Y COMPLETA TUS VALORES

# ===================================
# 🤖 CLAUDE API (REQUERIDO)
# ===================================
CLAUDE_API_KEY=sk-proj-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
CLAUDE_MODEL=claude-3-5-sonnet-20241022

# ===================================
# 📱 TWILIO (Para Whatsapp automático)
# ===================================
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_auth_token_here
TWILIO_WHATSAPP_NUMBER=+1234567890

# ===================================
# 📧 GMAIL (Para email automático)
# ===================================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=tu-email@gmail.com
SMTP_PASSWORD=xxxx xxxx xxxx xxxx

# ===================================
# 💼 CRM INTEGRATION
# ===================================
CRM_TYPE=none
PIPEDRIVE_API_KEY=your_pipedrive_api_key_here
HUBSPOT_API_KEY=pat-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ===================================
# 📍 GOOGLE MAPS
# ===================================
GOOGLE_MAPS_API_KEY=AIzaSy_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ===================================
# 💾 DATABASE
# ===================================
DB_TYPE=json
DATABASE_URL=postgresql://user:password@localhost:5432/aeterna_leads

# ===================================
# 🔄 SCRAPING
# ===================================
SHOPEE_ENABLED=true
OLX_ENABLED=true
GOOGLE_MAPS_ENABLED=false

# ===================================
# 🎯 AUTOMATIZACIÓN
# ===================================
SEND_WHATSAPP=false
SEND_EMAIL=false
EXPORT_TO_CRM=false
ENRICH_WITH_CLAUDE=true

# ===================================
# 📊 ANALYTICS
# ===================================
SENTRY_DSN=https://examplePublicKey@o0.ingest.sentry.io/0
ENVIRONMENT=development

# ===================================
# 🔐 SEGURIDAD
# ===================================
SECRET_KEY=your_super_secret_key_change_in_production

# ===================================
# 📝 LOGGING
# ===================================
LOG_LEVEL=INFO
