# Puerto en el que escucha la API
PORT=3000

# Clave(s) de API que los clientes deben enviar en el header "x-api-key".
# Separa varias claves con comas. Si se deja vacío, la autenticación queda deshabilitada (solo para desarrollo local).
API_KEYS=changeme-local-dev-key

# Clave de la API de Google PageSpeed Insights (https://developers.google.com/speed/docs/insights/v5/get-started)
# Opcional: si no se define, el análisis de rendimiento usa Lighthouse local vía Playwright/Chromium.
GOOGLE_PAGESPEED_API_KEY=

# Número máximo de auditorías ejecutándose en paralelo
MAX_CONCURRENT_ANALYSES=2

# Tiempo máximo (ms) que se le da a una auditoría completa antes de marcarla como fallida
ANALYSIS_TIMEOUT_MS=120000

# Nivel de log de pino: fatal | error | warn | info | debug | trace
LOG_LEVEL=info

# Ruta opcional a un binario de Chromium ya instalado. Déjalo vacío para que Playwright
# use su propio Chromium gestionado (recomendado en Docker con `npm run playwright:install`).
CHROMIUM_EXECUTABLE_PATH=
